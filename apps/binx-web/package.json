{
  "name": "binx-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "integrity": "node ../../scripts/check-code-integrity.mjs",
    "dev": "node ../../scripts/check-code-integrity.mjs && next dev",
    "build": "node ../../scripts/check-code-integrity.mjs && next build",
    "start": "next start",
    "lint": "node ../../scripts/check-code-integrity.mjs && eslint",
    "test": "node ../../scripts/check-code-integrity.mjs && vitest run",
    "test:watch": "node ../../scripts/check-code-integrity.mjs && vitest",
    "test:coverage": "node ../../scripts/check-code-integrity.mjs && vitest run --coverage",
    "test:e2e": "node ../../scripts/check-code-integrity.mjs && playwright test",
    "test:e2e:ui": "node ../../scripts/check-code-integrity.mjs && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "seed:e2e": "uv run --no-sync --project ../binx-api python -m binx_api.scripts.seed_e2e",
    "gen:api": "openapi-typescript ../binx-api/openapi.json -o src/lib/api-schema.d.ts",
    "screenshots": "node ../../scripts/check-code-integrity.mjs && cross-env PW_SCREENSHOTS=1 playwright test --grep @screenshots --project=desktop-chromium",
    "screenshots:build": "pnpm screenshots && node scripts/optimize-shots.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@sentry/nextjs": "^11.13.0",
    "@stripe/connect-js": "3.5.1",
    "@stripe/react-connect-js": "3.5.2",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.108.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
