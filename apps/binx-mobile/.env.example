# binx-api base URL.
#
# Testing in Expo Go on a physical phone: your phone and your computer must be
# on the same Wi-Fi network, and this MUST be your computer's LAN IP (not
# localhost/127.0.0.1 — that would resolve to the phone itself).
#   macOS: ipconfig getifaddr en0
#   Linux: hostname -I
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
