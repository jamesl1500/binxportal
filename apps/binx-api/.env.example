# Copy to .env and adjust. Every value has a safe local default in
# core/config.py — this file documents what's tunable and what a real
# deployment must override. `.env` is gitignored; `.env.example` is not.

# --- Database ---------------------------------------------------------------
# SQLAlchemy async URL (asyncpg driver). Used by the app and by Alembic
# (alembic/env.py reads it from here via Settings).
DATABASE_URL=postgresql+asyncpg://binxapi:binxapi@localhost:5432/binxportal

# --- Auth / JWT -----------------------------------------------------------
# MUST be set to a long random string in any non-local environment.
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# A just-rotated refresh token stays valid this long so concurrent requests
# from one session (multiple tabs, the web app's proxy) don't knock each
# other out. Replay after this window is still rejected.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30

# Per-IP rate limiting on the auth endpoints (login / signup / password reset /
# verification resend). On by default. Storage is in-process — front with Redis
# before running more than one API instance. The web E2E job sets this false.
RATE_LIMIT_ENABLED=true

# --- Frontend --------------------------------------------------------------
# Base URL the staff portal is served from; used to build links in emails.
FRONTEND_URL=http://localhost:3000

# --- Uploads --------------------------------------------------------------
# Local-disk root for uploaded project/task files. Swap for object storage
# before this matters in production.
PROJECT_UPLOAD_DIR=uploads/projects
PROJECT_UPLOAD_MAX_BYTES=26214400
# Same, for message attachments (messaging/service.py).
MESSAGE_UPLOAD_DIR=uploads/messages
MESSAGE_UPLOAD_MAX_BYTES=26214400

# --- Messaging websocket -------------------------------------------------
# How long a /auth/ws-ticket token is valid (seconds) — long enough to open
# one socket, no longer. The browser can't send the bearer header on a
# cross-origin WS handshake, so it trades the session for one of these first.
WS_TICKET_EXPIRE_SECONDS=60

# --- Tests --------------------------------------------------------------
# Only read by the test suite (tests/conftest.py). Defaults to a local
# binxportal_test database; the suite never touches DATABASE_URL above.
# TEST_DATABASE_URL=postgresql+asyncpg://binxapi:binxapi@localhost:5432/binxportal_test

# --- AI (Claude) ------------------------------------------------------------
# Anthropic API key — powers modules/ai/ (lead analysis, dashboard briefing,
# project/invoice drafting, the "Ask AI" assistant). The SDK's own default
# env var name, so `anthropic.AsyncAnthropic()` picks it up with zero config.
# Every AI feature fails gracefully with "AI isn't configured yet" when this
# is unset — leave it blank in dev if you don't have a key.
ANTHROPIC_API_KEY=
# AI_MODEL handles the features that need real reasoning (lead-website
# analysis, the "Ask AI" assistant's tool-calling loop); AI_FAST_MODEL is the
# cheaper/quicker model for templated drafts (dashboard briefing, project
# summary, invoice reminder) — see ai/client.py::complete's `fast` flag.
AI_MODEL=claude-sonnet-5
AI_FAST_MODEL=claude-haiku-4-5-20251001
# Per-agency defaults for a lazily-created AgencyAiSettings row (owner/admin
# can raise these per agency afterward). Monthly budget is USD cents.
AI_DEFAULT_MONTHLY_BUDGET_CENTS=2000
AI_DEFAULT_DAILY_USER_CAP=50

# --- Stripe (platform billing + client-invoicing Connect) -------------------
# Unset (the default) cleanly turns off both Stripe-backed features — plan
# changes fall back to the old direct-switch behavior and the portal "pay"
# button reports online payment isn't set up yet. See billing/service.py and
# invoicing/service.py.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Platform events (customer.subscription.*, checkout.session.completed for a
# plan subscription) — from the Dashboard/CLI endpoint pointed at
# /webhooks/stripe/platform.
STRIPE_WEBHOOK_SECRET=
# Connect events (account.updated, checkout.session.completed for an invoice
# payment) — a SEPARATE endpoint/secret, pointed at /webhooks/stripe/connect
# with "Listen to events on Connected accounts" enabled.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Recurring monthly Price ids from the Stripe Dashboard for the three paid
# plans (Free has no Stripe price). Test-mode and live-mode accounts mint
# different ids, so these can't live in the plan catalog itself.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_SCALE=
# Basis points of a client-invoice payment Binx keeps as a platform fee (0 =
# none). Only applies to Connect "direct charge" invoice payments, never to
# platform subscription revenue.
STRIPE_APPLICATION_FEE_BPS=0