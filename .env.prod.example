# Copy to `.env` in /opt/binxportal on the box (NOT committed — this is a
# template). docker-compose.prod.yml reads it automatically.

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# The Anthropic API key that powers modules/ai/ — leave blank to run without
# AI features (they fail gracefully; see apps/binx-api/.env.example).
ANTHROPIC_API_KEY=

# Filled in by deploy/redeploy.sh from the :sha tag it just pushed — set
# once by hand for the very first `docker compose up -d`.
API_IMAGE=<account-id>.dkr.ecr.us-east-2.amazonaws.com/binx-api:latest
WEB_IMAGE=<account-id>.dkr.ecr.us-east-2.amazonaws.com/binx-web:latest
