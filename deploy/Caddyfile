# Reverse proxy + automatic TLS for both apps on the single EC2 instance.
# Caddy requests/renews Let's Encrypt certs for each host block below on its
# own — no ACM, no ALB. Requires ports 80 (ACME HTTP-01 challenge + redirect)
# and 443 to be reachable from the internet, which they already are on this
# instance's security group.

api.binxportal.com {
	reverse_proxy api:8000
}

# www is canonical (see lib/site.ts's SITE_URL / NEXT_PUBLIC_SITE_URL) — the
# apex 301s there instead of serving the same content twice, so search
# engines see one URL per page, not two.
binxportal.com {
	redir https://www.binxportal.com{uri} permanent
}

www.binxportal.com {
	reverse_proxy web:3000
}

# Agency custom subdomains (Settings → General; Starter plan and above —
# see binx-api's agencies/service.py::SUBDOMAIN_MIN_PLAN). DNS-01 instead of
# the HTTP-01 challenge the blocks above use: Let's Encrypt can't issue a
# wildcard cert any other way. The `route53` DNS plugin (built into this
# image — see deploy/Dockerfile.caddy) authenticates via this EC2 instance's
# own IAM role, so no AWS keys appear here (see infra/lib/dns-stack.ts for
# the exact grant). `www` and `api` above are matched first regardless of
# file order — Caddy always prefers the most specific host match — so this
# block only ever catches an actual agency subdomain.
*.binxportal.com {
	tls {
		dns route53
	}
	reverse_proxy web:3000
}

# --- Staging (docker-compose.staging.yml) -----------------------------------
# Same box, separate compose project, reached over the shared
# `binxportal-edge` network. If the staging stack is down these just 502 —
# nothing here can affect the production blocks above.

(staging) {
	header X-Robots-Tag "noindex, nofollow"
}

# No basic auth on the API host: the browser calls it cross-origin with a
# bearer token (and over websockets), and binx-web's own server calls it too
# — none of which could answer a basic-auth challenge.
api.staging.binxportal.com {
	import staging
	reverse_proxy staging-api:8000
}

staging.binxportal.com {
	import staging
	# Generated on the box by deploy/redeploy.sh from the staging secret's
	# STAGING_BASIC_AUTH_USER / STAGING_BASIC_AUTH_PASSWORD. A glob, so a
	# missing file (no password set) is a warning, not a config error.
	import /etc/caddy/staging-auth.caddy*
	reverse_proxy staging-web:3000
}
